# Copy to .env and fill in your GROQ_API_KEY.
# All other values have working local defaults.

# ---- Groq (online LLM) ----
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ---- Postgres (docker-compose) ----
POSTGRES_USER=fitmind
POSTGRES_PASSWORD=fitmind
POSTGRES_DB=fitmind_fitness

# Admin/owner connection — used only by scripts/setup_db.py and scripts/seed_db.py.
# Host port is 5433 to avoid colliding with a local Postgres you may have.
DATABASE_URL=postgresql+psycopg://fitmind:fitmind@localhost:5433/fitmind_fitness

# Least-privilege role NL2SQL-generated SQL actually runs as (created by setup_db.py).
# Leave READONLY_DATABASE_URL blank to have it derived automatically.
READONLY_DB_USER=fitmind_readonly
READONLY_DB_PASSWORD=fitmind_readonly_pw
READONLY_DATABASE_URL=

# ---- API / UI wiring ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
